# TCE Syllabus Validator Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/tce_syllabus_db

# Security & Authentication
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=tce_super_secret_jwt_signing_key_at_least_32_characters_long_2026
ALLOWED_DOMAIN=tce.edu

# Academic Regulations
CURRENT_REGULATION=26
CURRENT_YEAR=2026

# Administrator Accounts (comma-separated @tce.edu emails)
ADMIN_EMAILS=admin@tce.edu,hod.cse@tce.edu

# Extractor Flags
ENABLE_LLM_EXTRACTION=false
GEMINI_API_KEY=
